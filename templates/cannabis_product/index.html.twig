{% extends 'base.html.twig' %}

{% block products %}
    {% for product in products %}
        <div class="col mb-5">
            <div class="card h-100">
                <!-- Sale badge-->
                {% if product.avgRating >= 4 %}
                    <div class="badge bg-dark text-white position-absolute" style="top: 0.5rem; right: 0.5rem">Best</div>
                {% endif %}
                <!-- Product image-->
                <img class="card-img-top" style="height: 175px; " src="{{ asset('images/' ~ product.imageUrl) }}" alt="..." />
                <!-- Product details-->
                <div class="card-body p-4">
                    <div class="text-center">
                        <!-- Product name-->
                        <h5 class="fw-bolder">{{ product.name }}</h5>
                        <!-- Product reviews-->
                        <div>
                            <div class="text-nowrap">THC Content {{ product.thcContent }} %</div>
                            <div class="text-nowrap">CBD Content {{ product.cbdContent }} %</div>
                        </div>
                        <div class="text-nowrap justify-content-center small text-warning mb-2">
                            {% for i in range(1, 5) %}
                                {% if i <= product.avgRating %}
                                    <div class="bi-star-fill"></div>
                                {% else %}
                                    <div class="bi-star"></div>
                                {% endif %}
                            {% endfor %}
                            <span class="text-black">({{ product.countRating }})</span>
                        </div>
                    </div>
                </div>
                <!-- Product actions-->
                <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                    <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="{{ path('app_cannabis_product_rating.index', { 'productId' : product.id }) }}">See Ratings</a></div>
                    <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="{{ path('app_cannabis_product_rating.create', { 'productId' : product.id }) }}">Create Rating</a></div>
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock %}
