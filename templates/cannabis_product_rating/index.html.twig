{% extends 'base.html.twig' %}

{% block title %}Hello CannabisProductRatingController!{% endblock %}

{% block Headline2 %}
    Bewertungen for
    {% if product.producer is defined and product.producer is not null %}
       {{ product.producer.name }}
    {% endif %}
    {{ product.name }}
{% endblock %}

{% block filter %}
    <div class="container px-4 px-lg-5 mt-5">
        <div class="">
            <a href="{{ path('app_cannabis_product.index') }}" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left"></i> Zurück zu den Produkten
            </a>
        </div>
    </div>
{% endblock %}

{% block products %}
    {% for rating in ratings %}
        <div class="col mb-5">
            <div class="card h-100" style="max-width: 300px;">
                <!-- Product details-->
                <div class="card-body p-4">
                    <div class="text-center">
                        <!-- Product name-->
                        <h5 class="fw-bolder">Benutzer Bewertung</h5>
                        <!-- Product reviews-->
                        <div class="d-flex justify-content-center small text-warning mb-2">
                            <table class="table table-borderless">
                                {% for key, data in rating %}
                                    <tr>
                                        <td class="table-responsive"><span class="text-black">{{ key }}:</span>
                                        </td>
                                        <td class="table-responsive" style="width: 110px; min-width: 110px;">
                                            {% for i in range(1, data) %}
                                                <span class="text-warning bi-star-fill"></span>
                                            {% endfor %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Product actions-->
                <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                    <!-- <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="{{ path('app_cannabis_product_rating.index', { 'productId' : product.id }) }}">See Ratings</a></div> -->
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock %}
